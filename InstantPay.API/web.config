<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>

    <!-- IIS 10.0+: strip the Server header at the kernel/HTTP.sys level -->
    <security>
      <requestFiltering removeServerHeader="true" />
    </security>

    <!-- Remove headers injected by IIS and ASP.NET modules -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <remove name="X-AspNet-Version" />
        <remove name="X-AspNetMvc-Version" />
        <remove name="X-SourceFiles" />
      </customHeaders>
    </httpProtocol>

    <!-- Belt-and-suspenders: URL Rewrite outbound rule to blank the Server header
         (covers cases where requestFiltering is insufficient, e.g. Plesk-managed IIS) -->
    <rewrite>
      <outboundRules>
        <rule name="RemoveServerHeader" enabled="true">
          <match serverVariable="RESPONSE_Server" pattern=".+" />
          <action type="Rewrite" value="" />
        </rule>
        <rule name="RemoveXPoweredBy" enabled="true">
          <match serverVariable="RESPONSE_X-Powered-By" pattern=".+" />
          <action type="Rewrite" value="" />
        </rule>
      </outboundRules>
    </rewrite>

    <!-- Let ASP.NET Core handle all error responses (custom JSON errors via middleware).
         existingResponse="PassThrough" prevents IIS from replacing ASP.NET Core responses
         with its own detailed HTML error pages that disclose technology information. -->
    <httpErrors errorMode="Custom" existingResponse="PassThrough" />

    <!-- Disable directory listing -->
    <directoryBrowse enabled="false" />

    <!-- Standard in-process hosting for ASP.NET Core on IIS -->
    <aspNetCore processPath="dotnet"
                arguments=".\InstantPay.API.dll"
                stdoutLogEnabled="false"
                stdoutLogFile=".\logs\stdout"
                hostingModel="inprocess" />

  </system.webServer>
</configuration>
